<h1 class="mb-3"><%= @sauna.name %></h1>

<% if user_signed_in? %>
  <% favored = current_user.favorites.exists?(sauna: @sauna) %>

  <% if favored %>
    <%= button_to "お気に入り解除",
      sauna_favorite_path(@sauna),
      method: :delete,
      data: { turbo_confirm: "お気に入りを解除しますか？" },
      class: "btn btn-outline-danger mb-3" %>
  <% else %>
    <%= button_to "お気に入り",
      sauna_favorite_path(@sauna),
      method: :post,
      class: "btn btn-outline-primary mb-3" %>
  <% end %>
<% else %>
  <%= link_to "ログインしてお気に入り",
    new_user_session_path(redirect_to: request.fullpath),
    class: "btn btn-outline-primary mb-3" %>
<% end %>

<% unless user_signed_in? %>
  <div class="card my-3">
    <div class="card-body d-flex justify-content-between align-items-center">
      <div>
        <div class="fw-semibold">会員登録するともっと便利</div>
        <div class="text-muted small">お気に入り保存・レビュー投稿ができます</div>
      </div>
      <%= link_to "無料で会員登録", new_user_registration_path(redirect_to: request.fullpath), class: "btn btn-primary btn-sm" %>
    </div>
  </div>
<% end %>

<div class="card mb-4">
  <div class="card-body">
    <p class="mb-2"><strong>場所：</strong><%= @sauna.address %></p>
    <hr>
<h2 class="h4">アクセス</h2>

<div class="ratio ratio-16x9 mb-2">
  <% if @sauna.latitude.present? && @sauna.longitude.present? %>
    <iframe
      loading="lazy"
      referrerpolicy="no-referrer-when-downgrade"
      src="https://www.google.com/maps?q=<%= @sauna.latitude %>,<%= @sauna.longitude %>&output=embed">
    </iframe>
  <% else %>
    <iframe
      loading="lazy"
      referrerpolicy="no-referrer-when-downgrade"
      src="https://www.google.com/maps?q=<%= ERB::Util.url_encode(@sauna.address) %>&output=embed">
    </iframe>
  <% end %>
</div>

<% query = if @sauna.latitude.present? && @sauna.longitude.present?
             "#{@sauna.latitude},#{@sauna.longitude}"
           else
             @sauna.address.to_s
           end %>

<div>
  <%= link_to "Googleマップで開く",
              "https://www.google.com/maps/search/?api=1&query=#{ERB::Util.url_encode(query)}",
              target: "_blank", rel: "noopener",
              class: "btn btn-outline-primary btn-sm" %>
</div>

<% if @sauna.respond_to?(:website_url) && @sauna.website_url.present? %>
  <div class="mt-2">
    <%= link_to "公式サイト", @sauna.website_url, target: "_blank", rel: "noopener", class: "btn btn-outline-secondary btn-sm" %>
  </div>
<% end %>

    <p class="mb-2">
      <strong>サウナ温度：</strong><%= @sauna.temperature %>℃
      / <strong>水風呂：</strong><%= @sauna.water_temp %>℃
    </p>

    <p class="mb-2">
      <strong>外気浴：</strong><%= @sauna.has_outdoor_bath ? "あり" : "なし" %>
    </p>

    <div class="mb-2">
      <strong>営業時間：</strong>
      <% day_labels = %w[日 月 火 水 木 金 土] %>
      <% hours = (@sauna.respond_to?(:sauna_opening_hours) ? @sauna.sauna_opening_hours : []).to_a.sort_by { |h| h.day_of_week.to_i } %>

      <% if hours.present? %>
        <div class="table-responsive mt-2">
          <table class="table table-sm align-middle mb-0">
            <tbody>
              <% hours.each do |h| %>
                <% dow = h.day_of_week.to_i %>
                <% label = day_labels[dow] || dow.to_s %>
                <% opens = h.opens_at %>
                <% closes = h.closes_at %>
                <% overnight = opens.present? && closes.present? && closes < opens %>
                <tr>
                  <th scope="row" class="text-nowrap" style="width: 4rem;"><%= label %></th>
                  <td>
                    <% if h.respond_to?(:closed) && h.closed %>
                      <span class="text-muted">定休</span>
                    <% elsif opens.present? && closes.present? %>
                      <%= opens.strftime("%H:%M") %> 〜 <%= closes.strftime("%H:%M") %>
                      <% if overnight %>
                        <span class="text-muted small">（翌日）</span>
                      <% end %>
                    <% else %>
                      <span class="text-muted">未設定</span>
                    <% end %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <div class="text-muted mt-2">営業時間が未登録です。</div>
      <% end %>
    </div>

    <p class="mb-0"><strong>説明：</strong><br><%= simple_format(@sauna.description) %></p>
  </div>
</div>

<hr>

<div class="d-flex align-items-center justify-content-between">
  <h2 class="h4 mb-0">レビュー</h2>

  <% if user_signed_in? %>
    <%= link_to "レビューを書く", "#review-form", class: "btn btn-primary" %>
  <% else %>
    <%= link_to "ログインしてレビューを書く", new_user_session_path, class: "btn btn-outline-primary" %>
  <% end %>
</div>

<%# レビュー一覧 %>
<div class="mt-3">
  <% if defined?(@reviews) && @reviews.present? %>
    <div class="list-group">
      <% @reviews.each do |review| %>
        <div class="list-group-item">
          <div class="d-flex justify-content-between align-items-start">
            <div>
              <div class="fw-semibold">
                <%# 星（1〜5） %>
                <span aria-label="rating" title="評価：<%= review.rating %>">
                  <%= "★" * review.rating.to_i %><%= "☆" * (5 - review.rating.to_i) %>
                </span>
              </div>

              <% if review.comment.present? %>
                <div class="mt-2"><%= simple_format(review.comment) %></div>
              <% else %>
                <div class="mt-2 text-muted">（本文なし）</div>
              <% end %>
            </div>

            <small class="text-muted text-end">
  <% if review.user.present? %>
    <div>
      <%= if review.user.username.present?
            review.user.username
          elsif review.user.respond_to?(:name) && review.user.name.present?
            review.user.name
          else
            review.user.email
          end %>
    </div>
  <% end %>
  <div><%= l(review.created_at, format: :short) %></div>
</small>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <p class="text-muted mt-3">まだレビューがありません。最初のレビューを書いてみましょう。</p>
  <% end %>
</div>

<%# 投稿フォーム %>
<div id="review-form" class="mt-4">
  <h3 class="h5">レビューを書く</h3>

  <% if user_signed_in? %>
    <%= render "reviews/form", sauna: @sauna, review: @review %>
  <% else %>
    <p class="text-muted">レビュー投稿にはログインが必要です。</p>
    <%= link_to "ログインしてレビューを書く", new_user_session_path, class: "btn btn-outline-primary" %>
  <% end %>
</div>
