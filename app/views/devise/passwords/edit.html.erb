
<div class="container" style="max-width: 520px;">
  <h1 class="h4 mb-3">パスワード変更</h1>

  <div class="card mb-4">
    <div class="card-body">
      <p class="text-muted small mb-3">
        新しいパスワードを入力して、変更を完了してください。
      </p>

      <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put }) do |f| %>
        <%= render "devise/shared/error_messages", resource: resource %>
        <%= f.hidden_field :reset_password_token %>

        <div class="mb-3">
          <%= f.label :password, "新しいパスワード", class: "form-label" %>
          <%= f.password_field :password, autofocus: true, autocomplete: "new-password", class: "form-control" %>
          <% if @minimum_password_length %>
            <div class="form-text"><%= @minimum_password_length %>文字以上</div>
          <% end %>
        </div>

        <div class="mb-3">
          <%= f.label :password_confirmation, "新しいパスワード（確認）", class: "form-label" %>
          <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "form-control" %>
        </div>

        <div class="d-grid gap-2">
          <%= f.submit "パスワードを変更する", class: "btn btn-primary" %>
        </div>
      <% end %>

      <hr class="my-4">

      <div class="small">
        <%= render "devise/shared/links" %>
      </div>
    </div>
  </div>
</div>
