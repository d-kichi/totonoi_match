<h1 class="h4 mb-3">アカウント設定</h1>

<div class="card mb-4">
  <div class="card-body">
    <h2 class="h5 mb-3">メールアドレス・パスワード変更</h2>

    <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put }) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>

      <div class="mb-3">
        <%= f.label :email, "メールアドレス", class: "form-label" %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "form-control" %>
      </div>

      <div class="mb-3">
  <%= f.label :username, "ユーザー名", class: "form-label" %>
  <%= f.text_field :username,
      class: "form-control",
      placeholder: "公開用の名前（20文字以内）" %>
  <div class="form-text">
    他のユーザーに表示される名前です（メールアドレスは公開されません）
  </div>
</div>

      <% if devise_mapping.confirmable? && resource.pending_reconfirmation? %>
        <div class="alert alert-info">
          確認メール送信済み：<%= resource.unconfirmed_email %>
        </div>
      <% end %>

      <hr class="my-4">

      <div class="mb-3">
        <%= f.label :password, "新しいパスワード（変更しない場合は空欄）", class: "form-label" %>
        <%= f.password_field :password, autocomplete: "new-password", class: "form-control" %>
        <% if @minimum_password_length %>
          <div class="form-text"><%= @minimum_password_length %>文字以上</div>
        <% end %>
      </div>

      <div class="mb-3">
        <%= f.label :password_confirmation, "新しいパスワード（確認）", class: "form-label" %>
        <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "form-control" %>
      </div>

      <div class="mb-3">
        <%= f.label :current_password, "現在のパスワード（確認のため必須）", class: "form-label" %>
        <%= f.password_field :current_password, autocomplete: "current-password", class: "form-control" %>
        <div class="form-text">変更を確定するために入力してください。</div>
      </div>

      <div class="d-flex gap-2">
        <%= f.submit "更新する", class: "btn btn-primary" %>
        <%= link_to "マイページに戻る", mypage_path, class: "btn btn-outline-secondary" %>
      </div>
    <% end %>
  </div>
</div>

<div class="card border-danger">
  <div class="card-body">
    <h2 class="h5 text-danger mb-2">退会</h2>
    <p class="text-muted small mb-3">
      退会すると、レビューなどのデータにアクセスできなくなります（元に戻せません）。
    </p>

    <%= button_to "退会する",
      registration_path(resource_name),
      method: :delete,
      data: { turbo_confirm: "本当に退会しますか？この操作は取り消せません。" },
      class: "btn btn-outline-danger" %>
  </div>
</div>
