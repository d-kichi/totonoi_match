<div class="container" style="max-width: 520px;">
  <h1 class="h4 mb-3">新規登録</h1>

  <div class="card mb-4">
    <div class="card-body">
      <%= form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>
        <%= render "devise/shared/error_messages", resource: resource %>

        <div class="mb-3">
          <%= f.label :username, "ユーザー名", class: "form-label" %>
          <%= f.text_field :username, autofocus: true, class: "form-control", placeholder: "公開用の名前（20文字以内）" %>
          <div class="form-text">他のユーザーに表示される名前です。</div>
        </div>

        <div class="mb-3">
          <%= f.label :email, "メールアドレス", class: "form-label" %>
          <%= f.email_field :email, autocomplete: "email", class: "form-control" %>
        </div>

        <div class="mb-3">
          <%= f.label :password, "パスワード", class: "form-label" %>
          <%= f.password_field :password, autocomplete: "new-password", class: "form-control" %>
          <% if @minimum_password_length %>
            <div class="form-text"><%= @minimum_password_length %>文字以上</div>
          <% end %>
        </div>

        <div class="mb-3">
          <%= f.label :password_confirmation, "パスワード（確認）", class: "form-label" %>
          <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "form-control" %>
        </div>

        <div class="d-grid gap-2">
          <%= f.submit "新規登録", class: "btn btn-primary" %>
        </div>
      <% end %>

      <hr class="my-4">

      <div class="small">
        <%= render "devise/shared/links" %>
      </div>
    </div>
  </div>
</div>
