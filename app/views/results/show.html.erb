<div class="container my-4">
  <div class="d-flex flex-column flex-md-row align-items-md-end justify-content-between gap-2 mb-3">
    <div>
      <h1 class="h4 mb-1">あなたにおすすめのサウナ施設</h1>
      <p class="text-muted mb-0">診断結果に基づいて、相性が良い施設を表示しています。</p>
    </div>
    <div class="d-flex gap-2">
      <%= link_to "診断をやり直す", reset_diagnosis_path, class: "btn btn-outline-secondary btn-sm" %>
      <%= link_to "サウナタイプ結果に戻る",
                  result_diagnoses_path(result_id: (@result&.id || params[:result_id])),
                  class: "btn btn-outline-primary btn-sm" %>
    </div>
  </div>

  <% if @saunas.present? %>
    <div class="row g-3">
      <% @saunas.each do |sauna| %>
        <div class="col-12 col-md-6 col-lg-4">
          <div class="card h-100 shadow-sm position-relative">
            <div class="card-body">
              <div class="d-flex align-items-start justify-content-between gap-2">
                <div>
                  <h2 class="h5 mb-1">
                    <%= link_to sauna.name, sauna_path(sauna), class: "stretched-link text-decoration-none" %>
                  </h2>
                  <% if sauna.address.present? %>
                    <div class="text-muted small">場所：<%= sauna.address %></div>
                  <% end %>
                </div>

                <% if user_signed_in? %>
                  <div class="flex-shrink-0">
                    <% if @favorite_sauna_ids.include?(sauna.id) %>
                      <%= button_to "お気に入り解除",
                                    sauna_favorite_path(sauna_id: sauna.id),
                                    method: :delete,
                                    class: "btn btn-outline-secondary btn-sm" %>
                    <% else %>
                      <%= button_to "お気に入り",
                                    sauna_favorite_path(sauna_id: sauna.id),
                                    method: :post,
                                    class: "btn btn-primary btn-sm" %>
                    <% end %>
                  </div>
                <% end %>
              </div>

              <hr class="my-3" />

              <% if sauna.description.present? %>
                <p class="mb-3"><%= sauna.description %></p>
              <% else %>
                <p class="text-muted mb-3">説明文は準備中です。</p>
              <% end %>

              <div class="d-flex flex-wrap gap-2">
                <% if sauna.temperature.present? %>
                  <span class="badge text-bg-secondary">サウナ <%= sauna.temperature %>℃</span>
                <% end %>
                <% if sauna.water_temp.present? %>
                  <span class="badge text-bg-info">水風呂 <%= sauna.water_temp %>℃</span>
                <% end %>
              </div>
            </div>

            <% if sauna.address.present? %>
              <div class="card-footer bg-white border-0 pt-0">
                <div class="d-flex justify-content-between align-items-center">
                  <span class="text-muted small">地図で場所を確認できます</span>
                  <%= link_to "Googleマップで開く",
                              "https://www.google.com/maps/search/?api=1&query=#{ERB::Util.url_encode(sauna.address)}",
                              class: "btn btn-outline-primary btn-sm",
                              target: "_blank",
                              rel: "noopener" %>
                </div>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="card border-0 shadow-sm">
      <div class="card-body">
        <h2 class="h5 mb-2">おすすめサウナ情報が見つかりませんでした</h2>
        <p class="text-muted mb-3">
          条件を変えると、別のサウナタイプやおすすめ施設が表示される場合があります。
        </p>
        <div class="d-flex gap-2">
          <%= link_to "診断をやり直す", reset_diagnosis_path, class: "btn btn-primary" %>
          <%= link_to "トップへ戻る", root_path, class: "btn btn-outline-secondary" %>
        </div>
      </div>
    </div>
  <% end %>

  <% unless user_signed_in? %>
    <div class="card my-4 border-primary">
      <div class="card-body text-center">
        <h3 class="h5 mb-2">会員登録でお気に入り保存ができます</h3>
        <p class="text-muted mb-3">
          気になるサウナを保存して、あとで見返せるようにしましょう。
        </p>
        <div class="d-grid gap-2 d-sm-flex justify-content-sm-center">
          <%= link_to "無料で会員登録",
                      new_user_registration_path(redirect_to: request.fullpath),
                      class: "btn btn-primary" %>
          <%= link_to "ログイン",
                      new_user_session_path(redirect_to: request.fullpath),
                      class: "btn btn-outline-secondary" %>
        </div>
      </div>
    </div>
  <% end %>
</div>
