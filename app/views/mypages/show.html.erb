<div class="container" style="max-width: 720px;">
  <h1 class="h4 mb-3">マイページ</h1>

  <div class="card mb-4">
    <div class="card-body">
      <div class="fw-semibold">
        <%= if @user.respond_to?(:username) && @user.username.present?
              @user.username
            elsif @user.respond_to?(:name) && @user.name.present?
              @user.name
            else
              @user.email
            end %>
      </div>
      <div class="text-muted small">投稿したレビューの管理やアカウント設定ができます</div>
    </div>
  </div>

  <div class="card mb-4">
    <div class="card-body d-flex justify-content-between align-items-center">
      <div>
        <div class="fw-semibold">アカウント設定</div>
        <div class="text-muted small">ユーザー名・メールアドレス・パスワード変更、退会など</div>
      </div>
      <%= link_to "設定を開く", edit_user_registration_path, class: "btn btn-outline-secondary" %>
    </div>
  </div>

  <div class="d-flex align-items-center justify-content-between mb-2">
    <h2 class="h5 mb-0">お気に入りサウナ</h2>
    <%= link_to "サウナ一覧", saunas_path, class: "btn btn-outline-primary btn-sm" %>
  </div>
  <div class="text-muted small mb-3">気になるサウナを保存できます</div>

  <% if defined?(@favorite_saunas) && @favorite_saunas.present? %>
    <div class="list-group mb-4">
      <% @favorite_saunas.each do |sauna| %>
        <%= link_to sauna_path(sauna), class: "list-group-item list-group-item-action" do %>
          <div class="d-flex justify-content-between align-items-start gap-3">
            <div>
              <div class="fw-semibold"><%= sauna.name %></div>
              <div class="text-muted small"><%= sauna.address %></div>
            </div>
            <small class="text-muted text-end">
              <%= sauna.temperature %>℃ / <%= sauna.water_temp %>℃
            </small>
          </div>
        <% end %>
      <% end %>
    </div>
  <% else %>
    <div class="card mb-4">
      <div class="card-body">
        <div class="text-muted">お気に入りはまだありません。</div>
        <div class="mt-3">
          <%= link_to "サウナ一覧へ", saunas_path, class: "btn btn-outline-primary btn-sm" %>
        </div>
      </div>
    </div>
  <% end %>

  <div class="d-flex align-items-center justify-content-between mb-2">
    <h2 class="h5 mb-0">自分のレビュー</h2>
    <%= link_to "サウナ一覧", saunas_path, class: "btn btn-outline-primary btn-sm" %>
  </div>
  <div class="text-muted small mb-3">投稿したレビューの編集・削除ができます</div>

  <% if @reviews.present? %>
    <div class="list-group mb-4">
      <% @reviews.each do |review| %>
        <div class="list-group-item">
          <div class="d-flex justify-content-between align-items-start gap-3">
            <div class="flex-grow-1">
              <div class="fw-semibold">
                <%= link_to review.sauna.name, sauna_path(review.sauna), class: "text-decoration-none" %>
              </div>

              <div class="small" aria-label="rating" title="評価：<%= review.rating %>">
                <%= "★" * review.rating.to_i %><%= "☆" * (5 - review.rating.to_i) %>
              </div>

              <% if review.comment.present? %>
                <div class="mt-2"><%= simple_format(review.comment) %></div>
              <% else %>
                <div class="mt-2 text-muted small">（本文なし）</div>
              <% end %>

              <div class="mt-3 d-flex gap-2">
                <%= link_to "編集",
                    edit_sauna_review_path(review.sauna, review),
                    class: "btn btn-outline-secondary btn-sm" %>

                <%= link_to "削除",
                    sauna_review_path(review.sauna, review),
                    data: { turbo_method: :delete, turbo_confirm: "本当に削除しますか？" },
                    class: "btn btn-outline-danger btn-sm" %>
              </div>
            </div>

            <small class="text-muted text-end">
              <%= l(review.created_at, format: :short) %>
            </small>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="card mb-4">
      <div class="card-body">
        <div class="text-muted">まだレビューがありません。</div>
        <div class="mt-3">
          <%= link_to "サウナ一覧へ", saunas_path, class: "btn btn-outline-primary btn-sm" %>
        </div>
      </div>
    </div>
  <% end %>
</div>
