<h1 class="h4 mb-3">マイページ</h1>

<div class="card mb-4">
  <div class="card-body">
    <div class="fw-semibold">
      <%= if @user.respond_to?(:username) && @user.username.present?
            @user.username
          elsif @user.respond_to?(:name) && @user.name.present?
            @user.name
          else
            @user.email
          end %>
    </div>
    <div class="text-muted small">投稿したレビューを確認できます</div>
  </div>
</div>


<div class="card mb-4">
  <div class="card-body d-flex justify-content-between align-items-center">
    <div>
      <div class="fw-semibold">アカウント設定</div>
      <div class="text-muted small">メールアドレス・パスワード変更、退会など</div>
    </div>
    <%= link_to "設定を開く", edit_user_registration_path, class: "btn btn-outline-secondary" %>
  </div>
</div>

<h2 class="h5 mb-3">自分のレビュー</h2>

<% if @reviews.present? %>
  <div class="list-group">
    <% @reviews.each do |review| %>
      <div class="list-group-item">
        <div class="d-flex justify-content-between align-items-start">
          <div>
            <div class="fw-semibold">
              <%= link_to review.sauna.name, sauna_path(review.sauna) %>
            </div>

            <div aria-label="rating" title="評価：<%= review.rating %>">
              <%= "★" * review.rating.to_i %><%= "☆" * (5 - review.rating.to_i) %>
            </div>

            <% if review.comment.present? %>
              <div class="mt-2"><%= simple_format(review.comment) %></div>
            <% end %>

            <div class="mt-2 d-flex gap-2">
              <%= link_to "編集",
                  edit_sauna_review_path(review.sauna, review),
                  class: "btn btn-outline-secondary btn-sm" %>

              <%= link_to "削除",
                  sauna_review_path(review.sauna, review),
                  data: { turbo_method: :delete, turbo_confirm: "本当に削除しますか？" },
                  class: "btn btn-outline-danger btn-sm" %>
            </div>
          </div>

          <small class="text-muted text-end">
            <%= l(review.created_at, format: :short) %>
          </small>
        </div>
      </div>
    <% end %>
  </div>
<% else %>
  <p class="text-muted">まだレビューがありません。</p>
  <%= link_to "サウナ一覧へ", saunas_path, class: "btn btn-outline-primary btn-sm" %>
<% end %>
